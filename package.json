{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "jwt-viewer",
    "version": "0.1.0",
    "private": true,
    "description": "Decode, verify and generate JSON Web Tokens (RFC 7519) entirely in the browser. Next.js 16 + React 19 + TypeScript + Tailwind v4",
    "packageManager": "yarn@1.22.22",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "type-check": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "validate": "yarn type-check && yarn lint && yarn format:check && yarn test && yarn build",
        "prepare": "husky"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "jose": "^6.2.12",
        "lucide-react": "^1.59.0",
        "next": "^16.4.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/postcss": "^4.2.4",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript/typescript6": "^6.0.2",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "eslint-config-next": "^16.4.2",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "postcss": "^8.5.31",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.2.4",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.4"
    }
}
